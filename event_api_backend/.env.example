# Copy this file to .env and set values as needed.
# The application uses SQLite by default and does not require any configuration.
# To use a different database, set DATABASE_URL to a valid SQLAlchemy connection string.
# Example for PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

DATABASE_URL=sqlite:///./event_db.sqlite3
